# =============================================================
# BlackBook AI - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# Node Environment
# Options: development, production, test
NODE_ENV=development

# =============================================================
# Database (MongoDB)
# =============================================================
# MongoDB connection string for Mongoose
MONGODB_URI=mongodb://127.0.0.1:27017/blackbook_ai

# =============================================================
# Clerk Authentication
# =============================================================
# Get these from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Clerk sign-in/sign-up redirect URLs (optional)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# =============================================================
# Google Gemini AI
# =============================================================
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================
# Redis (BullMQ + ioredis for job queues)
# =============================================================
# If using Upstash or a self-hosted Redis instance
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# =============================================================
# Next.js
# =============================================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000