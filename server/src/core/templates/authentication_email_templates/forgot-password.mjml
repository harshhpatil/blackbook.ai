<mjml>
  <mj-head>
    <mj-title>Reset your password</mj-title>

    <mj-preview>
      Reset your Blackbook password — this link expires soon.
    </mj-preview>

    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
      />

      <mj-text
        color="#A1A1AA"
        font-size="15px"
        line-height="1.7"
      />

      <mj-section
        padding="0"
      />

      <mj-button
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
      />
    </mj-attributes>

    <mj-style>
      .container {
        border: 1px solid #27272A;
        border-radius: 14px;
        overflow: hidden;
      }

      .eyebrow {
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .brand {
        letter-spacing: -0.6px;
      }

      .footer-link {
        color: #71717A !important;
        text-decoration: none !important;
      }

      .muted-link {
        color: #52525B !important;
        text-decoration: none !important;
      }

      .cta-button a {
        text-decoration: none !important;
      }

      @media only screen and (max-width: 480px) {
        .container {
          border-radius: 10px !important;
        }

        .hero-title div {
          font-size: 30px !important;
          line-height: 1.18 !important;
          letter-spacing: -1px !important;
        }

        .mobile-padding {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }

        .mobile-header {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }

        .outer-spacing {
          padding: 20px 12px !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body
    background-color="#09090B"
    width="600px"
  >

    <!-- Outer spacing -->
    <mj-section
      background-color="#09090B"
      padding="28px 20px"
      css-class="outer-spacing"
    >
      <mj-column
        css-class="container"
        background-color="#0F0F11"
        padding="0"
      >

        <!-- Header -->
        <mj-section
          padding="18px 32px"
          css-class="mobile-header"
        >
          <mj-column width="50%">
            <mj-text
              css-class="brand"
              padding="0"
              font-size="18px"
              font-weight="800"
              color="#FAFAFA"
              line-height="1"
            >
              Blackbook.
            </mj-text>
          </mj-column>

          <mj-column width="50%">
            <mj-text
              align="right"
              padding="2px 0 0"
              font-size="10px"
              font-weight="600"
              color="#52525B"
              css-class="eyebrow"
            >
              GETBLACKBOOK.IN
            </mj-text>
          </mj-column>
        </mj-section>

        <!-- Header divider -->
        <mj-section padding="0 32px">
          <mj-column>
            <mj-divider
              border-width="1px"
              border-color="#27272A"
              padding="0"
            />
          </mj-column>
        </mj-section>

        <!-- Hero -->
        <mj-section
          padding="28px 40px 0"
          css-class="mobile-padding"
        >
          <mj-column>

            <!-- Eyebrow -->
            <mj-text
              css-class="eyebrow"
              padding="0 0 12px"
              font-size="10px"
              font-weight="700"
              color="#71717A"
            >
              PASSWORD RESET
            </mj-text>

            <!-- Heading -->
            <mj-text
              css-class="hero-title"
              padding="0"
              font-size="34px"
              line-height="1.15"
              font-weight="750"
              letter-spacing="-1.2px"
              color="#FAFAFA"
            >
              Reset your password.
            </mj-text>

            <!-- Intro -->
            <mj-text
              padding="14px 0 0"
              font-size="15px"
              line-height="1.65"
              color="#A1A1AA"
            >
              Hey {{name}}, we got a request to reset your
              Blackbook password.
            </mj-text>

            <mj-text
              padding="8px 0 0"
              font-size="15px"
              line-height="1.65"
              color="#A1A1AA"
            >
              Click the button below to choose a new one. This
              link expires in {{expiry_minutes}} minutes for
              your security.
            </mj-text>

          </mj-column>
        </mj-section>

        <!-- CTA -->
        <mj-section
          padding="20px 40px 32px"
          css-class="mobile-padding"
        >
          <mj-column>

            <mj-button
              css-class="cta-button"
              href="{{reset_url}}"
              background-color="#FAFAFA"
              color="#09090B"
              font-size="14px"
              font-weight="650"
              line-height="1"
              border-radius="7px"
              padding="0"
              inner-padding="14px 22px"
              align="left"
            >
              Reset password&nbsp;&nbsp;→
            </mj-button>

            <mj-text
              padding="10px 0 0"
              font-size="12px"
              line-height="1.5"
              color="#52525B"
            >
              If you didn't request this, you can safely
              ignore this email — your password won't change.
            </mj-text>

          </mj-column>
        </mj-section>

        <!-- Support block -->
        <mj-section
          padding="18px 40px"
          background-color="#0B0B0D"
          css-class="mobile-padding"
        >
          <mj-column>

            <mj-text
              padding="0 0 6px"
              font-size="13px"
              font-weight="600"
              color="#A1A1AA"
            >
              Need a hand?
            </mj-text>

            <mj-text
              padding="0"
              font-size="13px"
              line-height="1.65"
              color="#52525B"
            >
              If you have any questions or run into something,
              simply reply to this email. Our team will be happy
              to help.
            </mj-text>

          </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section
          padding="20px 32px 22px"
          background-color="#09090B"
        >
          <mj-column>

            <!-- Links -->
            <mj-text
              align="center"
              padding="0 0 12px"
              font-size="12px"
              line-height="1.6"
              color="#52525B"
            >
              <a
                href="https://getblackbook.in/help"
                class="footer-link"
              >
                Help Center
              </a>
              &nbsp;&nbsp;•&nbsp;&nbsp;
              <a
                href="https://getblackbook.in/privacy"
                class="footer-link"
              >
                Privacy
              </a>
              &nbsp;&nbsp;•&nbsp;&nbsp;
              <a
                href="https://getblackbook.in"
                class="footer-link"
              >
                Website
              </a>
            </mj-text>

            <!-- Copyright -->
            <mj-text
              align="center"
              padding="0"
              font-size="11px"
              line-height="1.6"
              color="#3F3F46"
            >
              ©2026 Team Getblackbook All rights reserved.
              <br />
              You're receiving this because you created a Blackbook account.
            </mj-text>

          </mj-column>
        </mj-section>

      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
