{
  "name": "blackbook.ai-backend",
  "version": "0.0.3",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "tsx watch ./src/index.ts",
    "test": "vitest run",
    "build": "tsc && copyfiles -u 1 \"src/**/*.mjml\" dist/",
    "worker": "tsx src/workers/run-worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@bull-board/api": "^8.6.1",
    "@bull-board/express": "^8.6.1",
    "@bull-board/metrics": "^8.6.1",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docxtemplater": "^3.69.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "libreoffice-convert": "^1.8.2",
    "mammoth": "^1.12.0",
    "mjml": "^5.4.0",
    "mongoose": "^9.7.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pizzip": "^3.2.0",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.6",
    "resend": "^6.19.0",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
