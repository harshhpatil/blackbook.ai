# ==============================================================================
# ENVIRONMENT & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
IS_PRODUCTION=false
PORT=5000

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=info
LOG_PRETTY_PRINT=true
LOG_REDACT_PATHS=authorization,cookie,set-cookie,password,refreshToken,accessToken,otp

# ==============================================================================
# SECURITY & CORS CONFIGURATION
# ==============================================================================
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
CROSS_SITE_COOKIES=false
# Set to '1' or 'true' when behind reverse proxy (e.g. Cloud Run, Nginx, ALB)
TRUST_PROXY=1

# ==============================================================================
# DATABASE & CACHING CONFIGURATION
# ==============================================================================
MONGO_URI=mongodb://localhost:27017/blackbook
# Upstash Redis / Redis URL:
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_COMMAND_TIMEOUT_MS=20000
REDIS_RATE_LIMIT_COMMAND_TIMEOUT_MS=3000
REDIS_KEEP_ALIVE_MS=30000
REDIS_RETRY_MAX_DELAY_MS=5000

# ==============================================================================
# AUTHENTICATION (JWT) CONFIGURATION
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=blackbook.ai-api
JWT_AUDIENCE=blackbook.ai-users

# ==============================================================================
# EMAIL (RESEND) CONFIGURATION
# ==============================================================================
RESEND_API_KEY=re_replace-with-your-resend-api-key
EMAIL_FROM_ADDRESS=Blackbook <noreply@example.com>

# ==============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
PAYMENT_SUCCESS_URL=http://localhost:5173/payments/payment-success
PAYMENT_CANCEL_URL=http://localhost:5173/payments/payment-cancel
PAYMENT_DEFAULT_CURRENCY=inr    

RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE (Shared with template-engine)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=getblackbook
R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://pub-replace-with-r2-subdomain.r2.dev

# ==============================================================================
# GOOGLE AI & OAUTH CONFIGURATION
# ==============================================================================
GOOGLE_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_INPUT_CHARS=250000
GEMINI_MAX_OUTPUT_TOKENS=32768
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ==============================================================================
# TWILIO NOTIFICATION CONFIGURATION
# ==============================================================================
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_CLIENT_SECRET=replace-with-twilio-client-secret
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# STANDALONE TEMPLATE ENGINE (DocMorph)
# ==============================================================================
# Local direct dev: http://localhost:5002
# Local Docker Compose network: http://blackbook-template-engine:5002
# GCP Cloud Run production: https://template-engine-<project-hash>.<region>.a.run.app
TEMPLATE_ENGINE_URL=http://localhost:5002
TEMPLATE_ENGINE_TIMEOUT_MS=90000
TEMPLATE_ENGINE_MAX_RETRIES=2
TEMPLATE_ENGINE_FAILURE_THRESHOLD=3
TEMPLATE_ENGINE_COOLDOWN_MS=15000

# ==============================================================================
# BILLING & CREDITS
# ==============================================================================
GENERATION_CREDIT_COST=1
CREDIT_PACKAGES_JSON={"credits_10":10,"credits_50":50}
