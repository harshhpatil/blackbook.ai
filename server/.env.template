# ==============================================================================
# ENVIRONMENT & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3000

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=info
LOG_PRETTY_PRINT=true
LOG_REDACT_PATHS=

# ==============================================================================
# SECURITY & CORS CONFIGURATION
# ==============================================================================
CLIENT_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3002
CROSS_SITE_COOKIES=false
TRUST_PROXY=

# ==============================================================================
# DATABASE & CACHING CONFIGURATION
# ==============================================================================
MONGO_URI=mongodb://localhost:27017/blackbook
REDIS_URL=redis://localhost:6379

# ==============================================================================
# AUTHENTICATION (JWT) CONFIGURATION
# ==============================================================================
# Note: Replace JWT_SECRET with a secure, 32+ character random string in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=blackbook.ai
JWT_AUDIENCE=blackbook.ai-api

# ==============================================================================
# EMAIL (SMTP) CONFIGURATION
# ==============================================================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-with-smtp-user
EMAIL_PASS=replace-with-smtp-password
EMAIL_FROM=no-reply@example.com

# ==============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
PAYMENT_SUCCESS_URL=http://localhost:5173/payments/payment-success
PAYMENT_CANCEL_URL=http://localhost:5173/payments/payment-cancel
PAYMENT_DEFAULT_CURRENCY=inr    

RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret


# Object storage (AWS S3 or an S3-compatible service such as MinIO)
AWS_ACCESS_KEY=replace-with-access-key
AWS_SECRET_KEY=replace-with-secret-key
AWS_S3_BUCKET_NAME=blackbook-assets
AWS_S3_REGION=ap-south-1
# Set for MinIO/local S3, e.g. http://localhost:9000. Leave empty for AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Gemini generation reliability limits
GOOGLE_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_INPUT_CHARS=250000
GEMINI_MAX_OUTPUT_TOKENS=32768

# Credits and paid packs. Keys must match the checkout `purpose` exactly.
GENERATION_CREDIT_COST=1
CREDIT_PACKAGES_JSON={"credits_10":10,"credits_50":50}
