# -----------------------------------------------------------------------------
# DocMorph AI Template Engine - Environment Configuration
# -----------------------------------------------------------------------------

# Server Port (matches core backend TEMPLATE_ENGINE_URL: http://localhost:5002)
PORT=5002

# Temporary storage directory (TMPDIR=/dev/shm is set in Dockerfile for Linux ramdisk)
# TMPDIR=/dev/shm

# -----------------------------------------------------------------------------
# Google Gemini / Vertex AI Configuration
# -----------------------------------------------------------------------------
# Mode 1: Gemini Developer API Key (Local Docker Compose / Dev)
GEMINI_API_KEY=your_gemini_api_key_here
# Supports GOOGLE_GEMINI_API_KEY alias matching core backend:
# GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Mode 2: GCP Cloud Run Vertex AI (Production with ADC)
# Set to 'true' to route requests through Google Cloud Vertex AI
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Model selection (defaults to gemini-2.5-flash or gemini-3.6-flash)
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Cloudflare R2 Object Storage (Shared with Core Backend)
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=getblackbook
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://pub-your_r2_public_domain.r2.dev
